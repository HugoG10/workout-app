{
  "expo": {
    "name": "Workout",
    "slug": "workout-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workoutapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Workout to use Face ID to sign in.",
        "LSApplicationQueriesSchemes": [
          "spotify",
          "music"
        ],
        "NSPhotoLibraryUsageDescription": "Allow Workout to use a photo for your profile.",
        "NSCameraUsageDescription": "Allow Workout to take a photo for your profile."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Workout to use Face ID to sign in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Workout to use Face ID to sign in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Workout to use a photo for your profile.",
          "cameraPermission": "Allow Workout to take a photo for your profile.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
